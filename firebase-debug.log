[debug] [2026-04-09T03:55:52.117Z] <<< [apiv2][status] POST https://firebaserules.googleapis.com/v1/projects/tiendapraxis/rulesets 200
[debug] [2026-04-09T03:55:52.117Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/tiendapraxis/rulesets {"name":"projects/tiendapraxis/rulesets/2e1006f9-90bb-4145-95fe-f2751376a461","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ── Helper Functions ──────────────────────────────────────────────────────\n\n    // True if the user is logged in\n    function isAuth() {\n      return request.auth != null;\n    }\n\n    // True if the user has a Custom Claim role in the given list\n    // Requires Firebase Custom Claims to be set (see syncUserClaims Cloud Function)\n    function hasRole(roles) {\n      return isAuth() && request.auth.token.role in roles;\n    }\n\n    // Convenience aliases\n    function isStaff() {\n      return hasRole(['SUPER_ADMIN', 'ADMIN', 'MANAGER', 'STAFF']);\n    }\n    function isManager() {\n      return hasRole(['SUPER_ADMIN', 'ADMIN', 'MANAGER']);\n    }\n    function isAdmin() {\n      return hasRole(['SUPER_ADMIN', 'ADMIN']);\n    }\n    function isSuperAdmin() {\n      return hasRole(['SUPER_ADMIN']);\n    }\n\n    // ── Public Submission Forms ───────────────────────────────────────────────\n\n    // Distributor contact form — public create, staff read only\n    match /distributors/{document} {\n      allow create: if true;\n      allow read: if isStaff();\n      allow update, delete: if false;\n    }\n\n    // Newsletter subscriptions — public create, staff read only\n    match /newsletter/{document} {\n      allow create: if true;\n      allow read: if isStaff();\n      allow update, delete: if false;\n    }\n\n    // WhatsApp click events — public create for tracking, staff read for analytics\n    match /whatsappClicks/{document} {\n      allow create: if true;\n      allow read:   if isStaff();\n      allow update, delete: if false;\n    }\n\n    // Cart event snapshots — append-only ledger of cart lifecycle events\n    // Public create so the storefront can write without auth.\n    // Staff read for analytics and Journey Panel.\n    match /cartSnapshots/{document} {\n      allow create: if true;\n      allow read:   if isStaff();\n      allow update, delete: if false;\n    }\n\n    // Session identity events — session_start and user_identified events written by the storefront.\n    // Public create (anonymous visitors write session_start before auth).\n    // Staff read for the Attribution Report and Customer Journey views.\n    match /sessionEvents/{document} {\n      allow create: if true;\n      allow read:   if isStaff();\n      allow update, delete: if false;\n    }\n\n    // ── System ───────────────────────────────────────────────────────────────\n\n    // System counters (order IDs, etc.) — staff read, admin write only\n    match /sys_counters/{document} {\n      allow read: if isStaff();\n      allow write: if isAdmin();\n    }\n\n    // Admin audit logs — staff read, staff write (system writes on actions)\n    // Note: write is needed so the app can log actions. Ideally done via Cloud Function.\n    match /admin_logs/{document} {\n      allow read: if isStaff();\n      allow write: if isStaff();\n    }\n\n    // Site Configuration — public read, admin write.\n    // NOTE: world-readable means all fields in these documents are browser-accessible.\n    // Do NOT store plain-text secrets (clientSecret, secretKey, access tokens) in any\n    // config document. Secret credentials belong in Firebase Functions environment variables.\n    // The config/integrations document should contain only publishable/public keys.\n    match /config/{document} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // System metadata (seed version, etc.) — admin only\n    match /_metadata/{document} {\n      allow read: if isStaff();\n      allow write: if isSuperAdmin();\n    }\n\n    // ── Users ─────────────────────────────────────────────────────────────────\n    //\n    // C2 FIX: Users can only read/update their own profile.\n    // SUPER_ADMIN can manage any user (role changes, deactivation, etc.)\n    // Staff can read all user docs (for assigning orders, etc.)\n    //\n    match /users/{userId} {\n      // Each user can read and update their own profile\n      allow read, update: if isAuth() && request.auth.uid == userId;\n      // Staff can read all users (for order management, CRM, etc.)\n      allow read: if isStaff();\n      // Only SUPER_ADMIN can create or delete users (or change roles)\n      allow create, delete: if isSuperAdmin();\n      // Prevent self-role-escalation: only SUPER_ADMIN can write the 'role' field\n      allow update: if isSuperAdmin();\n    }\n\n    // Customers collection (mirrors users for storefront)\n    match /customers/{customerId} {\n      // Customers can read/update their own record\n      allow read, update: if isAuth() && request.auth.uid == customerId;\n      // Staff can read all customers\n      allow read: if isStaff();\n      // System creates customer records on sign-up (authenticated)\n      allow create: if isAuth();\n      // Only admins can delete\n      allow delete: if isAdmin();\n      \n      // CRM Notes Subcollection\n      match /notes/{noteId} {\n        allow read, write: if isStaff();\n      }\n    }\n\n    // Staff profiles — internal team extended profiles (read by staff, written by admin)\n    match /staff_profiles/{document} {\n      allow read: if isStaff();\n      allow write: if isAdmin();\n    }\n\n    // ── Catalogue (C1 FIX) ────────────────────────────────────────────────────\n    // Products, banners, blog, categories, etc. — all need ADMIN+ to write\n\n    match /banners/{document} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /campaigns/{document} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // blog_posts — the single authoritative blog collection (posts rule was removed; nothing used it)\n    match /blog_posts/{document} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /brands/{document} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /categories/{document} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /products/{document} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /productTypeTemplates/{document} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /coupons/{document} {\n      allow read: if true;\n      allow write: if isManager();\n\n      // Allow public to increment scanCount\n      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scanCount'])\n                    && (\n                      (!('scanCount' in resource.data) && request.resource.data.scanCount == 1) ||\n                      (request.resource.data.scanCount == resource.data.scanCount + 1)\n                    );\n\n      // Allow anyone to log a scan\n      match /scans/{scanId} {\n        allow create: if true;\n        allow read:   if isManager();\n        // Allow storefront to mark a scan as converted (at checkout success).\n        // Only conversion fields may be updated — no other fields.\n        allow update: if request.resource.data.diff(resource.data)\n                           .affectedKeys()\n                           .hasOnly(['converted', 'orderId', 'discountUsed', 'convertedAt']);\n      }\n    }\n\n    match /productKits/{document} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /locations/{document} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // ── Pricing (Admin only) ──────────────────────────────────────────────────\n\n    match /channel_commission_rules/{document} {\n      allow read: if isStaff();\n      allow write: if isAdmin();\n    }\n\n    match /pricing_rules/{document} {\n      allow read: if isStaff();\n      allow write: if isAdmin();\n    }\n\n    match /pricing_strategies/{document} {\n      allow read: if isStaff();\n      allow write: if isAdmin();\n    }\n\n    match /pricing_history/{document} {\n      allow read: if isStaff();\n      allow write: if isAdmin();\n    }\n\n    // pricing_templates was referenced in code but lacked a rule — would silently deny.\n    match /pricing_templates/{document} {\n      allow read: if isStaff();\n      allow write: if isAdmin();\n    }\n\n    // ── PDFs ─────────────────────────────────────────────────────────────────\n\n    match /pdfs/{document} {\n      // Public PDFs are publicly readable\n      allow read: if resource.data.active == true && resource.data.isPublic == true;\n      // Authenticated users can read all active PDFs\n      allow read: if isAuth() && resource.data.active == true;\n      // Only staff can write\n      allow write: if isStaff();\n    }\n\n    match /pdf_downloads/{document} {\n      allow create: if true; // Anyone can log downloads\n      allow read: if isStaff();\n      allow update, delete: if false;\n    }\n\n    // ── Orders (C3 FIX) ───────────────────────────────────────────────────────\n    //\n    // Customers can read their own orders only.\n    // Staff can read all orders.\n    // Only staff can create/update/delete orders.\n    //\n\n    match /orders/{orderId} {\n      // Customer can read their own orders\n      allow read: if isAuth() && resource.data.customer.uid == request.auth.uid;\n      // Staff can read all orders\n      allow read: if isStaff();\n      // Only staff can create, update, or delete orders\n      allow create, update: if isStaff();\n      // Only SUPER_ADMIN and admins can delete orders\n      allow delete: if isAdmin();\n    }\n\n    match /orderAssignments/{document} {\n      allow read: if isStaff();\n      allow write: if isManager();\n    }\n\n    match /orderNotes/{document} {\n      allow read: if isStaff();\n      allow write: if isStaff();\n    }\n\n    match /orderPriorities/{document} {\n      allow read: if isStaff();\n      allow write: if isManager();\n    }\n\n    // ── Approval Requests ─────────────────────────────────────────────────────\n\n    match /approval_requests/{document} {\n      // Managers and above can read all requests\n      allow read: if isManager();\n      // Users can read their own requests\n      allow read: if isAuth() && resource.data.requestedBy.uid == request.auth.uid;\n      // Admin and above can create requests\n      allow create: if isAdmin();\n      // Only MANAGER+ can approve/reject\n      allow update: if isManager() && request.resource.data.status in ['APPROVED', 'REJECTED'];\n      // Requesters can cancel their own pending requests\n      allow update: if isAuth()\n                    && resource.data.requestedBy.uid == request.auth.uid\n                    && resource.data.status == 'PENDING'\n                    && request.resource.data.status == 'CANCELLED';\n      // Only SUPER_ADMIN can delete (no more open dev delete)\n      allow delete: if isSuperAdmin();\n    }\n\n    // ── Financials ────────────────────────────────────────────────────────────\n\n    match /expenses/{document} {\n      allow read, write: if isManager();\n    }\n\n    // ── Inventory ─────────────────────────────────────────────────────────────\n\n    match /inventory_ledger/{document} {\n      allow read, write: if isStaff();\n    }\n\n    match /inventory_balances/{document} {\n      allow read, write: if isStaff();\n    }\n\n    match /purchase_orders/{document} {\n      allow read: if isStaff();\n      allow write: if isManager();\n    }\n\n    match /supplier_product_mappings/{document} {\n      allow read: if isStaff();\n      allow write: if isAdmin();\n    }\n\n    // ── Warehouse Layout ──────────────────────────────────────────────────────\n    // All warehouse sub-entities (zones, structures, locations, obstacles,\n    // doors, scaleMarkers) are now subcollections under warehouses/{warehouseId}.\n    // The {=**} wildcard covers the root doc AND any depth of subcollections.\n\n    match /warehouses/{warehouseId} {\n      allow read: if true;          // warehouse list shown on storefront\n      allow write: if isAdmin();\n\n      match /{subCollection}/{document} {\n        allow read: if isStaff();   // staff-only: layout is internal tooling\n        allow write: if isAdmin();\n      }\n    }\n\n    // ── Media ─────────────────────────────────────────────────────────────────\n\n    match /media_folders/{document} {\n      allow read: if true;\n      allow write: if isStaff();\n    }\n\n    match /media_assets/{document} {\n      allow read: if true;\n      allow write: if isStaff();\n    }\n\n    // ── MercadoLibre ──────────────────────────────────────────────────────────\n\n    match /meli_items/{document} {\n      allow read: if isStaff();\n      allow write: if isAdmin();\n    }\n\n    match /meli_fbm_inventory/{document} {\n      allow read: if isStaff();\n      allow write: if isAdmin();\n    }\n\n    match /meli_webhook_logs/{document} {\n      allow read: if isStaff();\n      allow write: if isAdmin();\n    }\n\n    // ── Notifications ─────────────────────────────────────────────────────────\n\n    match /notifications/{document} {\n      // Users can read their own notifications\n      allow read: if isAuth() && resource.data.userId == request.auth.uid;\n      // Staff can read all\n      allow read: if isStaff();\n      // System (authenticated) can create notifications\n      allow create: if isAuth();\n      // Users can update/delete their own, staff can manage all\n      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;\n      allow update, delete: if isStaff();\n    }\n\n    // ── Analytics (append-only, public) ───────────────────────────────────────\n\n    // search_events — unified query + click tracking (replaces search_logs + search_clicks)\n    match /search_events/{document} {\n      allow create: if true;          // storefront writes anonymously\n      allow read:   if isStaff();\n      allow update, delete: if false; // append-only\n    }\n    // Legacy collections kept read-accessible while old data is still present\n    match /search_logs/{document} {\n      allow read: if isStaff();\n      allow create, update, delete: if false; // no new writes\n    }\n    match /search_clicks/{document} {\n      allow read: if isStaff();\n      allow create, update, delete: if false; // no new writes\n    }\n\n    // ── Commerce: Carts ───────────────────────────────────────────────────────\n\n    match /carts/{cartId} {\n      // Anyone can create a cart (needed for anonymous → user handoff)\n      allow create: if true;\n      // Authenticated owner can read/update their own cart\n      allow read, update: if isAuth() && request.auth.uid == cartId;\n      // Staff can read all carts (ops dashboard, recovery campaigns)\n      allow read: if isStaff();\n      // Only admins can delete\n      allow delete: if isAdmin();\n    }\n\n    // ── Commerce: Guest Carts (anonymous visitor tracking) ────────────────────\n    //\n    // Written by unauthenticated visitors who add items without logging in.\n    // The sessionId in the document payload MUST match the document path ID —\n    // this prevents one session from overwriting another's data.\n    // Reads are staff-only to protect visitor PII (IP, device, geo).\n    //\n    // Note: We write even when items=[] to preserve `cleared_by_user`,\n    // `migrated`, and `abandoned` status changes for analytics.\n    //\n    match /guestCarts/{sessionId} {\n      // Anyone (including unauthenticated) can create/update their own session cart.\n      // Validate that the sessionId field in the payload matches the document ID.\n      allow create, update: if request.resource.data.sessionId == sessionId;\n      // Staff can read all guest carts (for ops dashboard and recovery emails)\n      allow read: if isStaff();\n      // No client-side deletes — we mark as 'migrated'/'abandoned' to preserve history\n      allow delete: if isAdmin();\n    }\n\n    // ── Promotions ────────────────────────────────────────────────────────────\n\n    match /promotions/{document} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-04-09T03:55:52.542527Z","metadata":{"services":["cloud.firestore"]}}
