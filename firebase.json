{
    "functions": {
        "source": "functions"
    },
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "hosting": [
        {
            "target": "storefront",
            "public": "dist/storefront/browser",
            "cleanUrls": true,
            "trailingSlash": false,
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ],
            "headers": [
                {
                    "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css|eot|otf|ttf|ttc|woff|woff2|font.css)",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "max-age=31536000"
                        }
                    ]
                },
                {
                    "source": "index.html",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache, no-store, must-revalidate"
                        }
                    ]
                },
                {
                    "source": "service-worker.js",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache, no-store, must-revalidate"
                        }
                    ]
                }
            ]
        },
        {
            "target": "internal",
            "public": "dist/internal-app/browser",
            "cleanUrls": true,
            "trailingSlash": false,
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ],
            "headers": [
                {
                    "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css|eot|otf|ttf|ttc|woff|woff2|font.css)",
                    "headers": [
                        { "key": "Cache-Control", "value": "max-age=31536000" }
                    ]
                },
                {
                    "source": "/index.html",
                    "headers": [
                        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
                    ]
                },
                {
                    "source": "/**",
                    "headers": [
                        { "key": "X-Content-Type-Options", "value": "nosniff" },
                        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
                        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
                        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://sdk.mercadopago.com https://www.googletagmanager.com https://scripts.clarity.ms https://www.clarity.ms https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.cdnfonts.com; font-src 'self' https://fonts.gstatic.com https://fonts.cdnfonts.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.ipify.org https://api.zippopotam.us https://firestore.googleapis.com https://firebasestorage.googleapis.com https://identitytoolkit.googleapis.com https://secure.googleapis.com https://securetoken.googleapis.com https://o.clarity.ms https://z.clarity.ms https://c.bing.com https://*.google-analytics.com https://maps.googleapis.com https://us-central1-tiendapraxis.cloudfunctions.net https://www.googletagmanager.com https://*.googleapis.com wss://*.firebaseio.com; frame-src 'self' https://tiendapraxis.firebaseapp.com https://apis.google.com https://accounts.google.com https://*.firebaseapp.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" }
                    ]
                }
            ]
        }
    ]
}