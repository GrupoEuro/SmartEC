rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────────

    // True if the user is logged in
    function isAuth() {
      return request.auth != null;
    }

    // True if the user has a Custom Claim role in the given list
    // Requires Firebase Custom Claims to be set (see syncUserClaims Cloud Function)
    function hasRole(roles) {
      return isAuth() && request.auth.token.role in roles;
    }

    // Convenience aliases
    function isStaff() {
      return hasRole(['SUPER_ADMIN', 'ADMIN', 'MANAGER', 'STAFF']);
    }
    function isManager() {
      return hasRole(['SUPER_ADMIN', 'ADMIN', 'MANAGER']);
    }
    function isAdmin() {
      return hasRole(['SUPER_ADMIN', 'ADMIN']);
    }
    function isSuperAdmin() {
      return hasRole(['SUPER_ADMIN']);
    }

    // ── Public Submission Forms ───────────────────────────────────────────────

    // Distributor contact form — public create, staff read only
    match /distributors/{document} {
      allow create: if true;
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // Newsletter subscriptions — public create, staff read only
    match /newsletter/{document} {
      allow create: if true;
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // WhatsApp click events — public create for tracking, staff read for analytics
    match /whatsappClicks/{document} {
      allow create: if true;
      allow read:   if isStaff();
      allow update, delete: if false;
    }

    // Cart event snapshots — append-only ledger of cart lifecycle events
    // Public create so the storefront can write without auth.
    // Staff read for analytics and Journey Panel.
    match /cartSnapshots/{document} {
      allow create: if true;
      allow read:   if isStaff();
      allow update, delete: if false;
    }

    // Session identity events — session_start and user_identified events written by the storefront.
    // Public create (anonymous visitors write session_start before auth).
    // Staff read for the Attribution Report and Customer Journey views.
    match /sessionEvents/{document} {
      allow create: if true;
      allow read:   if isStaff();
      allow update, delete: if false;
    }

    // ── System ───────────────────────────────────────────────────────────────

    // System counters (order IDs, etc.) — staff read, admin write only
    match /sys_counters/{document} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Admin audit logs — staff read, staff write (system writes on actions)
    // Note: write is needed so the app can log actions. Ideally done via Cloud Function.
    match /admin_logs/{document} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Site Configuration — public read, admin write.
    // NOTE: world-readable means all fields in these documents are browser-accessible.
    // Do NOT store plain-text secrets (clientSecret, secretKey, access tokens) in any
    // config document. Secret credentials belong in Firebase Functions environment variables.
    // The config/integrations document should contain only publishable/public keys.
    match /config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Storefront Order Counter ───────────────────────────────────────────────
    // Override the general config write-lock for this specific counter doc.
    // Allows the storefront checkout to atomically increment the web order number.
    // Strict field validation: only the `web` integer field may be written,
    // and it must equal the previous value + 1 (prevents arbitrary writes).
    match /config/orderCounters {
      allow read: if true;
      // resource == null means the document does not exist yet (first order).
      // Checking resource.data when resource is null causes the rule to error → deny.
      // We must guard with resource == null before accessing resource.data.
      allow write: if request.resource.data.keys().hasAll(['web'])
                   && request.resource.data.web is int
                   && (
                        (resource == null && request.resource.data.web == 1)
                        || (resource != null && request.resource.data.web == resource.data.web + 1)
                      );
    }

    // System metadata (seed version, etc.) — admin only
    match /_metadata/{document} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    //
    // C2 FIX: Users can only read/update their own profile.
    // SUPER_ADMIN can manage any user (role changes, deactivation, etc.)
    // Staff can read all user docs (for assigning orders, etc.)
    //
    match /users/{userId} {
      // Each user can read and update their own profile
      allow read, update: if isAuth() && request.auth.uid == userId;
      // Staff can read all users (for order management, CRM, etc.)
      allow read: if isStaff();
      // Only SUPER_ADMIN can create or delete users (or change roles)
      allow create, delete: if isSuperAdmin();
      // Prevent self-role-escalation: only SUPER_ADMIN can write the 'role' field
      allow update: if isSuperAdmin();
    }

    // Customers collection (mirrors users for storefront)
    match /customers/{customerId} {
      // Customers can read/update their own record
      allow read, update: if isAuth() && request.auth.uid == customerId;
      // Staff can read all customers
      allow read: if isStaff();
      // System creates customer records on sign-up (authenticated)
      allow create: if isAuth();
      // Only admins can delete
      allow delete: if isAdmin();
      
      // CRM Notes Subcollection
      match /notes/{noteId} {
        allow read, write: if isStaff();
      }
    }

    // Staff profiles — internal team extended profiles (read by staff, written by admin)
    match /staff_profiles/{document} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ── Catalogue (C1 FIX) ────────────────────────────────────────────────────
    // Products, banners, blog, categories, etc. — all need ADMIN+ to write

    match /banners/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /campaigns/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // blog_posts — the single authoritative blog collection (posts rule was removed; nothing used it)
    match /blog_posts/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productTypeTemplates/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{document} {
      allow read: if true;
      allow write: if isManager();

      // Allow public to increment scanCount
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scanCount'])
                    && (
                      (!('scanCount' in resource.data) && request.resource.data.scanCount == 1) ||
                      (request.resource.data.scanCount == resource.data.scanCount + 1)
                    );

      // Allow anyone to log a scan
      match /scans/{scanId} {
        allow create: if true;
        allow read:   if isManager();
        // Allow storefront to mark a scan as converted (at checkout success).
        // Only conversion fields may be updated — no other fields.
        allow update: if request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly(['converted', 'orderId', 'discountUsed', 'convertedAt']);
      }
    }

    match /productKits/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /locations/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Pricing (Admin only) ──────────────────────────────────────────────────

    match /channel_commission_rules/{document} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /pricing_rules/{document} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /pricing_strategies/{document} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /pricing_history/{document} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // pricing_templates was referenced in code but lacked a rule — would silently deny.
    match /pricing_templates/{document} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ── PDFs ─────────────────────────────────────────────────────────────────

    match /pdfs/{document} {
      // Public PDFs are publicly readable
      allow read: if resource.data.active == true && resource.data.isPublic == true;
      // Authenticated users can read all active PDFs
      allow read: if isAuth() && resource.data.active == true;
      // Only staff can write
      allow write: if isStaff();
    }

    match /pdf_downloads/{document} {
      allow create: if true; // Anyone can log downloads
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // ── Orders (C3 FIX) ───────────────────────────────────────────────────────
    //
    // Storefront checkout creates orders client-side with status 'pending_payment'.
    // All subsequent updates (payment result, shipping, etc.) are done by the
    // Cloud Function via Admin SDK — which bypasses these rules entirely.
    //

    match /orders/{orderId} {
      // Customer can read their own orders (identified by email or uid)
      allow read: if isAuth() && resource.data.customer.uid == request.auth.uid;
      // Staff can read all orders
      allow read: if isStaff();

      // Storefront checkout: allow creating a pending_payment order.
      // Constraints: must be from storefront channel, status must be pending_payment,
      // paymentStatus must be pending, and must have a customer email.
      allow create: if request.resource.data.sourceChannel == 'storefront'
                    && request.resource.data.status == 'pending_payment'
                    && request.resource.data.paymentStatus == 'pending'
                    && request.resource.data.customer.email is string
                    && request.resource.data.customer.email.size() > 0;

      // Staff can create or update any order
      allow create, update: if isStaff();
      // Only SUPER_ADMIN and admins can delete orders
      allow delete: if isAdmin();
    }

    match /orderAssignments/{document} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /orderNotes/{document} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /orderPriorities/{document} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // ── Approval Requests ─────────────────────────────────────────────────────

    match /approval_requests/{document} {
      // Managers and above can read all requests
      allow read: if isManager();
      // Users can read their own requests
      allow read: if isAuth() && resource.data.requestedBy.uid == request.auth.uid;
      // Admin and above can create requests
      allow create: if isAdmin();
      // Only MANAGER+ can approve/reject
      allow update: if isManager() && request.resource.data.status in ['APPROVED', 'REJECTED'];
      // Requesters can cancel their own pending requests
      allow update: if isAuth()
                    && resource.data.requestedBy.uid == request.auth.uid
                    && resource.data.status == 'PENDING'
                    && request.resource.data.status == 'CANCELLED';
      // Only SUPER_ADMIN can delete (no more open dev delete)
      allow delete: if isSuperAdmin();
    }

    // ── Financials ────────────────────────────────────────────────────────────

    match /expenses/{document} {
      allow read, write: if isManager();
    }

    // ── Inventory ─────────────────────────────────────────────────────────────

    match /inventory_ledger/{document} {
      allow read, write: if isStaff();
    }

    match /inventory_balances/{document} {
      allow read, write: if isStaff();
    }

    match /purchase_orders/{document} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /supplier_product_mappings/{document} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ── Warehouse Layout ──────────────────────────────────────────────────────
    // All warehouse sub-entities (zones, structures, locations, obstacles,
    // doors, scaleMarkers) are now subcollections under warehouses/{warehouseId}.
    // The {=**} wildcard covers the root doc AND any depth of subcollections.

    match /warehouses/{warehouseId} {
      allow read: if true;          // warehouse list shown on storefront
      allow write: if isAdmin();

      match /{subCollection}/{document} {
        allow read: if isStaff();   // staff-only: layout is internal tooling
        allow write: if isAdmin();
      }
    }

    // ── Media ─────────────────────────────────────────────────────────────────

    match /media_folders/{document} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /media_assets/{document} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ── MercadoLibre ──────────────────────────────────────────────────────────

    match /meli_items/{document} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /meli_listings/{document} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /meli_fbm_inventory/{document} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /meli_webhook_logs/{document} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /meli_communications/{document} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /meli_insights/{document} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Amazon SP-API sync run logs — written by Cloud Functions (Admin SDK), read by staff.
    match /amazon_sync_logs/{document} {
      allow read: if isStaff();
      allow write: if false; // Cloud Function (Admin SDK) only
    }

    // MeLi Full operations config: demand events, lead time, etc.
    // Staff can read; managers can create/update/delete events.
    match /config_demand_events/{document} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // ── Notifications ─────────────────────────────────────────────────────────

    match /notifications/{document} {
      // Users can read their own notifications
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      // Staff can read all
      allow read: if isStaff();
      // System (authenticated) can create notifications
      allow create: if isAuth();
      // Users can update/delete their own, staff can manage all
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow update, delete: if isStaff();
    }

    // ── Analytics (append-only, public) ───────────────────────────────────────

    // search_events — unified query + click tracking (replaces search_logs + search_clicks)
    match /search_events/{document} {
      allow create: if true;          // storefront writes anonymously
      allow read:   if isStaff();
      allow update, delete: if false; // append-only
    }
    // Legacy collections kept read-accessible while old data is still present
    match /search_logs/{document} {
      allow read: if isStaff();
      allow create, update, delete: if false; // no new writes
    }
    match /search_clicks/{document} {
      allow read: if isStaff();
      allow create, update, delete: if false; // no new writes
    }

    // ── Commerce: Carts ───────────────────────────────────────────────────────

    match /carts/{cartId} {
      // Anyone can create a cart (needed for anonymous → user handoff)
      allow create: if true;
      // Authenticated owner can read/update their own cart
      allow read, update: if isAuth() && request.auth.uid == cartId;
      // Staff can read all carts (ops dashboard, recovery campaigns)
      allow read: if isStaff();
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ── Commerce: Guest Carts (anonymous visitor tracking) ────────────────────
    //
    // Written by unauthenticated visitors who add items without logging in.
    // The sessionId in the document payload MUST match the document path ID —
    // this prevents one session from overwriting another's data.
    // Reads are staff-only to protect visitor PII (IP, device, geo).
    //
    // Note: We write even when items=[] to preserve `cleared_by_user`,
    // `migrated`, and `abandoned` status changes for analytics.
    //
    match /guestCarts/{sessionId} {
      // Anyone (including unauthenticated) can create/update their own session cart.
      // Validate that the sessionId field in the payload matches the document ID.
      allow create, update: if request.resource.data.sessionId == sessionId;
      // Staff can read all guest carts (for ops dashboard and recovery emails)
      allow read: if isStaff();
      // No client-side deletes — we mark as 'migrated'/'abandoned' to preserve history
      allow delete: if isAdmin();
    }

    // ── Promotions ────────────────────────────────────────────────────────────

    match /promotions/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Analytics: Monthly Sales Rollup ───────────────────────────────────────
    // Pre-aggregated monthly totals used for YoY dashboard comparison.
    // Document IDs are YYYY-MM (e.g. "2024-04").
    // Written by order.service write hooks (admin) and the bootstrap tool.
    // Read by the Operations Dashboard to compute the YoY delta badge.

    match /monthly_stats/{monthId} {
      allow read:  if isStaff();
      allow write: if isAdmin();

      // Daily subcollection: per-day rollup docs (YYYY-MM/days/DD)
      // Written by bootstrap tool and aggregateDailyStats scheduled function.
      match /days/{dayId} {
        allow read:  if isStaff();
        allow write: if isAdmin();
      }
    }

    // ── Price Intelligence ────────────────────────────────────────────────────
    // Market scan results written by meliPriceScan Cloud Function (Admin SDK).
    // Staff can read; no client-side writes (function handles all writes).

    match /price_intelligence/{fingerprint} {
      allow read: if isStaff();
      allow write: if false; // written by meliPriceScan Cloud Function only

      // Daily stats snapshots: price_intelligence/{fp}/history/{YYYY-MM-DD}
      // Written by Cloud Function on every live scan.
      match /history/{dateId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    // Price alerts generated when a competitor undercuts us by >5%.
    // Staff can read and mark as read; Cloud Function creates them.

    match /price_alerts/{alertId} {
      allow read:   if isStaff();
      allow update: if isStaff(); // mark as read
      allow create, delete: if false; // Cloud Function only
    }

    // ── Phase 2: Product Reviews ───────────────────────────────────────────────
    // Authenticated users can create one review per product per order.
    // Approved reviews are publicly readable (for JSON-LD aggregateRating).
    // Staff can manage (approve/reject).

    match /product_reviews/{productId}/reviews/{reviewId} {
      // Public can read approved reviews
      allow read: if resource.data.status == 'approved';
      // Staff can read all reviews (moderation queue)
      allow read: if isStaff();
      // Authenticated users can create a review
      allow create: if isAuth()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      // Staff can approve/reject
      allow update: if isStaff();
      // Only admin can delete
      allow delete: if isAdmin();
    }

    // ── Phase 2: Cart Recovery Queue ─────────────────────────────────────────
    // Written by onCartAbandoned Cloud Function (Admin SDK — always bypasses rules).
    // Staff read for ops visibility. No client writes.

    match /recovery_queue/{document} {
      allow read: if isStaff();
      allow write: if false; // Cloud Function (Admin SDK) only
    }

    // ── Phase 2: Review Requests ─────────────────────────────────────────────

    match /review_requests/{document} {
      allow read: if isStaff();
      allow write: if false; // Cloud Function (Admin SDK) only
    }

    // ── Phase 2: Notification Outbox ─────────────────────────────────────────
    // Provider-agnostic message queue. Staff can read; Cloud Function writes.

    match /notification_outbox/{document} {
      allow read: if isStaff();
      allow write: if false; // Cloud Function (Admin SDK) only
    }

    // ── Phase 2: Referral Rewards ─────────────────────────────────────────────
    // Staff read for reporting. Cloud Function writes via Admin SDK.

    match /referral_rewards/{document} {
      allow read: if isStaff();
      allow write: if false; // Cloud Function (Admin SDK) only
    }


    // ── Pre-Aggregated Analytics Collections ──────────────────────────────────
    // Written exclusively by Cloud Functions via Admin SDK (bypasses rules).
    // Staff read for all Operations and Marketing dashboards.
    // No client-side writes — all mutations go through aggregateDailyStats
    // or backfillAnalytics Cloud Functions.

    match /analytics_daily/{dateId} {
      allow read:  if isStaff();
      allow write: if false; // Cloud Function (Admin SDK) only

      // Hourly sub-documents: analytics_daily/{date}/hours/{HH}
      match /hours/{hourId} {
        allow read:  if isStaff();
        allow write: if false;
      }
    }

    match /analytics_monthly/{monthId} {
      allow read:  if isStaff();
      allow write: if false; // Cloud Function (Admin SDK) only
    }

    match /analytics_channel_snapshots/{channelId} {
      allow read:  if isStaff();
      allow write: if false; // Cloud Function (Admin SDK) only

      // Per-day sub-documents: analytics_channel_snapshots/{channel}/days/{date}
      match /days/{dateId} {
        allow read:  if isStaff();
        allow write: if false;
      }
    }

    // ── Rate Limiting (Checkout) ──────────────────────────────────────────────
    // Written by Cloud Functions and storefront auth service.
    // Staff read for monitoring abuse. TTL policy should be enabled in
    // Firebase Console (Firestore → TTL Policies → _rate_limits → expiresAt).

    match /_rate_limits/{document} {
      allow read:   if isStaff();
      allow create, update: if true;  // storefront writes counter atomically
      allow delete: if isAdmin();
    }

    // ── Universal Inbox — Atención al Cliente ─────────────────────────────────
    // Conversations are created/updated by Cloud Functions via Admin SDK (webhooks).
    // Staff can read all conversations and update operational fields (status,
    // assignedTo, tags, unreadCount). No client-side creates — all new
    // conversations are created server-side by the webhook handlers.
    //
    // The sendInboxReply callable writes outbound messages via Admin SDK,
    // so no client write rules are needed for subcollection messages.

    match /customer_conversations/{conversationId} {
      // All staff can read conversations (inbox, analytics)
      allow read: if isStaff();
      
      // Admin override for data seeding and system maintenance
      allow create, update, delete: if isAdmin();

      // ── Website channel: anonymous visitors can start a conversation ─────────
      // Strict: must be website channel, must have customerName, no admin fields.
      allow create: if request.resource.data.channel == 'website'
                    && request.resource.data.customerName is string
                    && request.resource.data.customerName.size() > 0
                    && request.resource.data.status == 'open'
                    // Prevent visitors from pre-assigning or escalating priority
                    && request.resource.data.assignedTo == null
                    && request.resource.data.priority == 'normal';

      // Staff can update operational fields: status, assignedTo, tags, unreadCount, snoozedUntil
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['status', 'assignedTo', 'tags', 'unreadCount',
                                   'priority', 'snoozedUntil', 'resolvedAt', 'updatedAt',
                                   'lastMessage']);

      // No client-side deletes
      allow delete: if false;

      // ── Messages subcollection ─────────────────────────────────────────────
      // Staff read for thread display.
      // Visitors can create inbound messages on website-channel conversations.
      // Staff can create outbound replies directly (in addition to Cloud Function).
      match /messages/{messageId} {
        allow read: if isStaff();
        
        // Admin override for data seeding
        allow create, update, delete: if isAdmin();
        
        // Visitor create: must be inbound, must have content
        allow create: if request.resource.data.direction == 'inbound'
                      && request.resource.data.content is string
                      && request.resource.data.content.size() > 0;
        // Staff create (outbound reply from inbox UI)
        allow create: if isStaff();
        allow update, delete: if false;
      }
    }

    // ── EuroMind AI — Agents ──────────────────────────────────────────────────
    // AI agent configurations created and managed by admins in the internal app.
    // Admins can fully CRUD agents. Staff can read for operational visibility.
    // Cloud Functions (agentOrchestrator) always use Admin SDK — bypasses rules.

    match /ai_agents/{agentId} {
      allow read:   if isStaff();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── EuroMind AI — Knowledge Base ─────────────────────────────────────────
    // FAQ / knowledge entries scoped to an agent (agentId field).
    // Admins manage entries. Staff can read. Cloud Functions read via Admin SDK.

    match /ai_knowledge/{entryId} {
      allow read:   if isStaff();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── EuroMind AI — Interaction Logs ───────────────────────────────────────
    // Written exclusively by the agentOrchestrator Cloud Function via Admin SDK.
    // Admins and managers can read for analytics and debugging.
    // No client-side writes.

    match /ai_agent_logs/{logId} {
      allow read:  if isManager();
      allow write: if false; // Cloud Function (Admin SDK) only
    }

  }
}
