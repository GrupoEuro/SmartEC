rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper Functions ─────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPdfType() {
      return request.resource.contentType == 'application/pdf';
    }

    // Max 10MB for images, 50MB for PDFs
    function withinImageSizeLimit() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    function withinPdfSizeLimit() {
      return request.resource.size <= 50 * 1024 * 1024;
    }

    // ── Media Library (images) ───────────────────────────────────────────────
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && isImageType() && withinImageSizeLimit();
    }

    // ── PDF files ───────────────────────────────────────────────────────────
    match /pdfs/{pdfFileName} {
      allow read: if true;
      allow write: if isAuth() && isPdfType() && withinPdfSizeLimit();
    }

    // ── PDF Thumbnails (generated images) ───────────────────────────────────
    match /pdf-thumbnails/{imageId} {
      allow read: if true;
      allow write: if isAuth() && isImageType() && withinImageSizeLimit();
    }

    // ── Banners and other general images ────────────────────────────────────
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && isImageType() && withinImageSizeLimit();
    }

    // ── Catch-all: deny unmatched paths by default ───────────────────────────
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

  }
}

